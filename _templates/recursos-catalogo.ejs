<%
const slug = s => String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const temas = ['Estadística-CC Datos', 'IA', 'Bayesiana', 'Mejora de procesos', 'Innovación educativa', 'Comunicación científica', 'Competencia digital'];
const tipos = ['Curso/Taller', 'Libro', 'Recopilatorio', 'Vídeo', 'Datos', 'Juego'];
const usados = new Set(items.flatMap(i => i.temas || []));
const lenguajes = ['R', 'Python'].filter(l => items.some(i => (i.lenguaje || []).includes(l)));
const tiposUsados = new Set(items.map(i => i.tipo));
const series = [...new Set(items.map(i => i.serie).filter(Boolean))];
%>
<div class="recursos-page">
<div class="filtros filtros-fila" role="search">
<div class="f-buscar">
<label for="rec-buscar">Buscar</label>
<input id="rec-buscar" type="search" placeholder="Python, bayesiana, gamificación…" autocomplete="off">
</div>
<div>
<label for="f-tema">Tema</label>
<select id="f-tema" class="filtro" data-eje="tema">
<option value="">Todos</option>
<% for (const t of temas.filter(t => usados.has(t))) { %><option value="<%= t %>"><%= t %> (<%= items.filter(i => (i.temas || []).includes(t)).length %>)</option><% } %>
</select>
</div>
<div>
<label for="f-tipo">Tipo</label>
<select id="f-tipo" class="filtro" data-eje="tipo">
<option value="">Todos</option>
<% for (const t of tipos.filter(t => tiposUsados.has(t))) { %><option value="<%= t %>"><%= t %> (<%= items.filter(i => i.tipo === t).length %>)</option><% } %>
</select>
</div>
<div>
<label for="f-lenguaje">Lenguaje</label>
<select id="f-lenguaje" class="filtro" data-eje="lenguaje">
<option value="">Todos</option>
<% for (const l of lenguajes) { %><option value="<%= l %>"><%= l %> (<%= items.filter(i => (i.lenguaje || []).includes(l)).length %>)</option><% } %>
</select>
</div>
<% if (series.length) { %>
<div>
<label for="f-serie">Colección</label>
<select id="f-serie" class="filtro" data-eje="serie">
<option value="">Todas</option>
<% for (const s of series) { %><option value="<%= s %>"><%= s %> (<%= items.filter(i => i.serie === s).length %>)</option><% } %>
</select>
</div>
<% } %>
<div>
<label for="f-origen">Origen</label>
<select id="f-origen" class="filtro" data-eje="origen">
<option value="">Todos</option>
<option value="Propio">Propio</option>
<option value="Recomendado">Recomendado</option>
</select>
</div>
</div>

<div class="resumen" aria-live="polite">
<span id="rec-n"><%= items.length %> recursos</span>
<button type="button" id="rec-limpiar" hidden>Quitar filtros</button>
</div>

<div class="tarjetas" id="rec-grid">
<% for (const item of items) { %>
<article class="tarjeta" data-tipo="<%= item.tipo %>" data-temas="<%= (item.temas || []).join('|') %>" data-origen="<%= item.origen %>" data-serie="<%= item.serie || '' %>" data-lenguaje="<%= (item.lenguaje || []).join('|') %>"
data-texto="<%= [item.title, item.description, item.autoria, item.serie, (item.temas || []).join(' '), (item.lenguaje || []).join(' '), item.tipo].join(' ').toLowerCase() %>">
<div class="etiquetas">
<span class="tag t-<%= slug(item.tipo) %>"><%= item.tipo %></span>
<span class="tag tag-outline"><%= item.origen %></span>
<% if (item.serie) { %><span class="tag t-serie"><%= item.serie %></span><% } %>
<% for (const l of (item.lenguaje || [])) { %><span class="tag t-lenguaje t-<%= slug(l) %>"><%= l %></span><% } %>
</div>
<% if (item.portada) { %><img class="portada" src="<%- item.portada %>" alt="Portada de <%= item.title %>" loading="lazy"><% } %>
<h3><% if (item.path) { %><a href="<%- item.path %>"><%= item.title %></a><% } else { %><%= item.title %><% } %></h3>
<p class="desc"><%= item.resumen || item.description %></p>
<% if (item.autoria) { %><p class="pie"><%= item.autoria %></p><% } %>
<% if (item.mas) { %><p class="pie"><a href="<%- item.mas %>"><%= item.mas_texto || 'Más información' %></a></p><% } %>
<% if (item.nota) { %><p class="pie"><em><%= item.nota %></em></p><% } %>
<p class="pie"><%= (item.temas || []).join(' · ') %><% if (item.anio) { %> · <%= item.anio %><% } %></p>
</article>
<% } %>
</div>
</div>

<script>
(function () {
const estado = { tema: null, tipo: null, lenguaje: null, origen: null, serie: null, q: '' };
const tarjetas = Array.from(document.querySelectorAll('#rec-grid .tarjeta'));
const selects = Array.from(document.querySelectorAll('.filtros select.filtro'));
const buscar = document.getElementById('rec-buscar');
const n = document.getElementById('rec-n');
const limpiar = document.getElementById('rec-limpiar');
const norm = s => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

// Filtros desde la URL: recursos/?lenguaje=Python&tipo=Curso%2FTaller
const params = new URLSearchParams(location.search);
['tema', 'tipo', 'lenguaje', 'origen', 'serie'].forEach(k => { if (params.get(k)) estado[k] = params.get(k); });

function aplicar() {
let visibles = 0;
const q = norm(estado.q.trim());
tarjetas.forEach(t => {
const ok = (!estado.tema || t.dataset.temas.split('|').includes(estado.tema))
&& (!estado.tipo || t.dataset.tipo === estado.tipo)
&& (!estado.lenguaje || t.dataset.lenguaje.split('|').includes(estado.lenguaje))
&& (!estado.origen || t.dataset.origen === estado.origen)
&& (!estado.serie || t.dataset.serie === estado.serie)
&& (!q || norm(t.dataset.texto).includes(q));
t.hidden = !ok; if (ok) visibles++;
});
selects.forEach(s => { s.value = estado[s.dataset.eje] || ''; });
const filtrando = estado.tema || estado.tipo || estado.lenguaje || estado.origen || estado.serie || q;
n.textContent = visibles === 0 ? 'Ningún recurso con esos filtros.' :
(visibles === 1 ? '1 recurso' : visibles + ' recursos') + (filtrando ? ' con los filtros elegidos' : '');
limpiar.hidden = !filtrando;
}
selects.forEach(s => s.addEventListener('change', () => { estado[s.dataset.eje] = s.value || null; aplicar(); }));
buscar.addEventListener('input', () => { estado.q = buscar.value; aplicar(); });
limpiar.addEventListener('click', () => { estado.tema = estado.tipo = estado.lenguaje = estado.origen = estado.serie = null; estado.q = ''; buscar.value = ''; aplicar(); });
aplicar();
})();
</script>
