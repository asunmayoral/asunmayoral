<%
const slug = s => String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const tiposDe = i => [].concat(i.tipo || []);
// Todo lo que puede filtrar un botón: tipo(s), temas, lenguaje y origen
const marcas = i => [...tiposDe(i), ...(i.temas || []), ...(i.lenguaje || []), i.origen];
// Botones de filtro, en este orden. `valor` es lo que hay en los datos; `texto`, lo que se ve.
const botones = [
  {texto: 'Competencia Digital'}, {texto: 'Estadística-CCDatos'}, {texto: 'Comunicación'},
  {texto: 'Curso-Taller'}, {texto: 'Libro'}, {texto: 'Recopilatorio'}, {texto: 'Aprendizaje Activo'},
  {texto: 'Vídeos', valor: 'Vídeo'}, {texto: 'Propio'}, {texto: 'R'}, {texto: 'Python'}
].map(b => ({...b, valor: b.valor || b.texto}))
 .map(b => ({...b, n: items.filter(i => marcas(i).includes(b.valor)).length}))
 .filter(b => b.n > 0);
%>
<div class="recursos-page">
<div class="filtros" role="search">
<div>
<label for="rec-buscar">Buscar</label>
<input id="rec-buscar" type="search" placeholder="Python, bayesiana, gamificación…" autocomplete="off">
</div>
<div>
<span class="rotulo" id="rot-etiquetas">Filtrar por etiquetas</span>
<div class="chips" role="group" aria-labelledby="rot-etiquetas">
<% for (const b of botones) { %><button type="button" class="chip" data-valor="<%= b.valor %>" aria-pressed="false"><%= b.texto %> <span class="chip-n"><%= b.n %></span></button>
<% } %>
</div>
</div>
</div>

<div class="resumen" aria-live="polite">
<span id="rec-n"><%= items.length %> recursos</span>
<button type="button" id="rec-limpiar" hidden>Quitar filtros</button>
</div>

<div class="tarjetas" id="rec-grid">
<% for (const item of items) { %>
<article class="tarjeta" data-marcas="<%= marcas(item).join('|') %>"
data-texto="<%= [item.title, item.description, item.autoria, item.serie, (item.temas || []).join(' '), (item.lenguaje || []).join(' '), tiposDe(item).join(' ')].join(' ').toLowerCase() %>">
<div class="etiquetas">
<% for (const t of tiposDe(item)) { %><span class="tag t-<%= slug(t) %>"><%= t %></span><% } %>
<span class="tag tag-outline"><%= item.origen %></span>
<% if (item.serie) { %><span class="tag t-serie"><%= item.serie %></span><% } %>
<% for (const l of (item.lenguaje || [])) { %><span class="tag t-lenguaje t-<%= slug(l) %>"><%= l %></span><% } %>
</div>
<% if (item.portada) { %><img class="portada" src="<%- item.portada %>" alt="Portada de <%= item.title %>" loading="lazy"><% } %>
<h3><% if (item.path) { %><a href="<%- item.path %>"><%= item.title %></a><% } else { %><%= item.title %><% } %></h3>
<p class="desc"><%= item.resumen || item.description %></p>
<% if (item.autoria) { %><p class="pie"><%= item.autoria %></p><% } %>
<% if (item.mas || (item.pdf && item.pdf !== item.path)) { %><p class="pie"><%= [item.mas ? `<a href="${item.mas}">${item.mas_texto || 'Más información'}</a>` : '', (item.pdf && item.pdf !== item.path) ? `<a href="${item.pdf}">Copia en PDF</a>` : ''].filter(Boolean).join(' · ') %></p><% } %>
<% if (item.nota) { %><p class="pie"><em><%= item.nota %></em></p><% } %>
<p class="pie"><%= (item.temas || []).join(' · ') %><% if (item.anio) { %> · <%= item.anio %><% } %></p>
</article>
<% } %>
</div>
</div>

<script>
(function () {
// Varios botones a la vez = recursos que tienen TODAS las etiquetas elegidas
const activos = new Set();
let q = '';
const tarjetas = Array.from(document.querySelectorAll('#rec-grid .tarjeta'));
const chips = Array.from(document.querySelectorAll('.filtros .chip'));
const buscar = document.getElementById('rec-buscar');
const n = document.getElementById('rec-n');
const limpiar = document.getElementById('rec-limpiar');
const norm = s => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

// Desde la URL: recursos/?etiqueta=Curso-Taller,Python  o  recursos/?q=Prodigital
const params = new URLSearchParams(location.search);
(params.get('etiqueta') || '').split(',').map(s => s.trim()).filter(Boolean).forEach(v => activos.add(v));
if (params.get('q')) { q = params.get('q'); buscar.value = q; }

function aplicar() {
let visibles = 0;
const nq = norm(q.trim());
tarjetas.forEach(t => {
const marcas = t.dataset.marcas.split('|');
const ok = [...activos].every(v => marcas.includes(v)) && (!nq || norm(t.dataset.texto).includes(nq));
t.hidden = !ok; if (ok) visibles++;
});
chips.forEach(c => c.setAttribute('aria-pressed', activos.has(c.dataset.valor) ? 'true' : 'false'));
const filtrando = activos.size > 0 || nq;
n.textContent = visibles === 0 ? 'Ningún recurso con esos filtros.' :
(visibles === 1 ? '1 recurso' : visibles + ' recursos') + (filtrando ? ' con los filtros elegidos' : '');
limpiar.hidden = !filtrando;
}
chips.forEach(c => c.addEventListener('click', () => {
const v = c.dataset.valor; activos.has(v) ? activos.delete(v) : activos.add(v); aplicar();
}));
buscar.addEventListener('input', () => { q = buscar.value; aplicar(); });
limpiar.addEventListener('click', () => { activos.clear(); q = ''; buscar.value = ''; aplicar(); });
aplicar();
})();
</script>
