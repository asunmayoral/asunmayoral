<%
// Línea temporal de Docencia. Datos: docencia/docencia.yml, proyectos/proyectos.yml (innovación y competencia digital)
// y las etapas profesionales de investigacion/investigacion.yml.
const HOY = new Date().getFullYear(), Y0 = 1993, Y1 = HOY + 1, SPAN = Y1 - Y0;
const pc = (y) => ((y - Y0) / SPAN * 100).toFixed(2);
const slug = (t) => String(t).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40);
const esPro = (i) => i.categoria === 'Innovación docente' || i.categoria === 'Competencia digital';
const filas = [
  { id: 'grado', title: 'Grado y licenciaturas', sel: (i) => i.bloque === 'grado' || i.bloque === 'licenciatura' },
  { id: 'postgrado', title: 'Postgrado', sel: (i) => i.bloque === 'postgrado' },
  { id: 'continua', title: 'Formación continua', sel: (i) => i.bloque === 'continua' },
  { id: 'profesorado', title: 'Formación del profesorado', sel: (i) => i.bloque === 'profesorado' },
  { id: 'innovacion', title: 'Innovación y proyectos formativos', sel: (i) => esPro(i) && i.desde },
  { id: 'direccion', title: 'Dirección de tesis y trabajos', sel: (i) => i.bloque === 'direccion' }
];
const etapas = items.filter(i => i.clase === 'etapa');
const gest = etapas.find(e => e.gestion);
const marcas = []; for (let y = 1995; y < Y1; y += 5) marcas.push(y);
const rejilla = marcas.map(y => `<span class="tl-g" style="left:${pc(y)}%"></span>`).join('') +
  (gest ? `<span class="tl-gest" style="left:${pc(gest.desde)}%;width:${pc(Number(gest.hasta) - Number(gest.desde) + Y0)}%"></span>` : '');
const norma = (i) => {
  const d = Number(i.desde), pro = esPro(i);
  const actual = pro ? i.estado === 'Activo' : (!i.hasta || Number(i.hasta) > HOY);
  let h = pro ? (i.hasta ? Number(i.hasta) + 1 : (actual ? Y1 : d + 1)) : (i.hasta ? Math.max(Number(i.hasta), d + 1) : Y1);
  h = Math.min(h, Y1);
  const anios = i.anios || (pro || i.hasta ? (Number(i.hasta || d) === d ? String(d) : d + '–' + i.hasta) : d + '–hoy');
  return { i, d, h, actual, anios, href: '#' + (i.id || (pro ? 'pro-' + slug(i.title) : 'doc-' + d + '-' + slug(i.title))) };
};
%>
<div class="tl-wrap" tabindex="0" role="group" aria-label="Línea temporal de la docencia, de <%= Y0 %> a hoy. El mismo contenido está en las listas de cada apartado, más abajo.">
<div class="tl">

<div class="tl-row tl-eje">
<div class="tl-lab"></div>
<div class="tl-track"><% for (const y of marcas) { %><span class="tl-anio" style="left:<%= pc(y) %>%"><%= y %></span><% } %></div>
</div>

<div class="tl-row tl-etapas">
<div class="tl-lab"><strong>Etapas</strong></div>
<div class="tl-track"><%= rejilla %>
<% for (const e of etapas) { const d = Number(e.desde), h = e.hasta ? Number(e.hasta) : Y1; %>
<% if (e.punto) { %><span class="tl-hito" style="left:<%= pc(d + 0.5) %>%" title="<%- d + ' · ' + e.title %>"><%= e.corto %></span>
<% } else { %><span class="tl-etapa f<%= e.fila || 1 %><%= e.gestion ? ' gestion' : '' %>" style="left:<%= pc(d) %>%;width:<%= pc(h - d + Y0) %>%" title="<%- d + '–' + (e.hasta || 'hoy') + ' · ' + e.title %>"><%= e.corto %></span><% } %>
<% } %>
</div>
</div>

<% for (const f of filas) {
  const xs = items.filter(f.sel).map(norma).sort((a, b) => a.d - b.d || b.h - a.h);
  if (!xs.length) continue;
  const fin = [];
  for (const x of xs) { let r = fin.findIndex(v => v <= x.d); if (r < 0) { r = fin.length; fin.push(0); } fin[r] = x.h; x.r = r; }
%>
<div class="tl-row d-<%= f.id %>">
<div class="tl-lab"><a href="#<%= f.id %>"><%= f.title %></a><span class="tl-per"><%= Math.min(...xs.map(x => x.d)) %>–<%= xs.some(x => x.actual) ? 'hoy' : Math.max(...xs.map(x => x.h)) - 1 %></span></div>
<div class="tl-track" style="height:<%= fin.length * 21 + 3 %>px"><%= rejilla %>
<% for (const x of xs) { %><a class="dl-b<%= x.actual ? ' actual' : '' %>" href="<%- x.href %>" style="left:<%= pc(x.d) %>%;width:<%= pc(x.h - x.d + Y0) %>%;top:<%= x.r * 21 + 2 %>px" title="<%- x.anios + ' · ' + x.i.title %>"><% if (x.h - x.d >= 3) { %><%= x.i.corto || x.i.title %><% } else { %><span class="visually-hidden"><%- x.anios + ' · ' + x.i.title %></span><% } %></a><% } %>
</div>
</div>
<% } %>

</div>
</div>

<p class="tl-leyenda"><span><i class="k-b actual"></i> en curso</span><span><i class="k-b"></i> impartida en años anteriores</span><span><i class="k-g"></i> años de gestión universitaria</span></p>
